generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Fleet
  User
  Garage
  Supplier
}

enum SupplierApprovalStatus {
  Pending
  Approved
  Rejected
}

enum SupplierPartMappingStatus {
  uploaded
  processing
  mapped
  pending_review
  failed
}

enum SupplierPartMappingSource {
  local_db
  vin17    @map("17vin")
  manual
}

enum PartNumberType {
  mpn
  oem
  brand_part_number
  unknown
}

enum FleetVehicleStatus {
  active
  maintenance
  inactive
}

enum RfqSource {
  fleet
  user
}

enum RfqStatus {
  open
  closed
  cancelled
}

enum RfqBidStatus {
  submitted
  accepted
  rejected
  withdrawn
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum OrderSource {
  rfq
  direct
}

enum GarageServiceStatus {
  active
  inactive
}

enum GarageVerificationTarget {
  email
  mobile
}

enum GarageBookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum BusinessQueryType {
  BookDemo
  ScheduleDemo
  Contact
  Sales
  FleetDemo
  General
}

enum BusinessQueryStatus {
  New
  Reviewed
  Archived
}

model User {
  id                        String                      @id @default(cuid())
  publicId                  String                      @unique @default(dbgenerated("next_user_public_id()"))
  supplierPublicId          String?                     @unique
  garagePublicId            String?                     @unique
  firebaseUid               String?                     @unique
  email                     String?                     @unique
  phone                     String?                     @unique
  googleId                  String?                     @unique
  passwordHash              String?
  firstName                 String?
  lastName                  String?
  avatarUrl                 String?
  companyName               String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  state                     String?
  postalCode                String?
  country                   String?
  roles                     UserRole[]                  @default([User])
  activeRole                UserRole                    @default(User)
  isActive                  Boolean                     @default(true)
  supplierApprovalStatus    SupplierApprovalStatus      @default(Pending)
  supplierReviewedAt        DateTime?
  supplierReviewedByAdminId String?
  emailVerifiedAt           DateTime?
  lastLoginAt               DateTime?
  authVersion               Int                         @default(1)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  sessions                  UserSession[]
  supplierParts             SupplierPart[]
  supplierPartStocks        SupplierPartStock[]
  supplierPartPricings      SupplierPartPricing[]
  fleetVehicles             FleetVehicle[]
  rfqs                      Rfq[]
  rfqBids                   RfqBid[]
  buyerOrders               Order[]                     @relation("OrderBuyer")
  supplierOrders            Order[]                     @relation("OrderSupplier")
  garageServices            GarageService[]
  garageBookings            GarageBooking[]             @relation("GarageBookingGarage")
  customerGarageBookings    GarageBooking[]             @relation("GarageBookingCustomer")
  garageServiceReviews      GarageServiceReview[]       @relation("GarageServiceReviewGarage")
  customerServiceReviews    GarageServiceReview[]       @relation("GarageServiceReviewCustomer")
  savedParts                UserSavedPart[]
  addresses                 UserAddress[]
  userVehicles              UserVehicle[]
  garageProfile             GarageProfile?
  garageVerifications       GarageVerificationRequest[]
  notifications             Notification[]              @relation("UserNotificationRecipient")
  sentNotifications         Notification[]              @relation("UserNotificationActor")
  supplierReviewedBy        admin?                      @relation("SupplierApprovalReviewer", fields: [supplierReviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([roles], type: Gin)
  @@index([activeRole])
  @@index([isActive])
  @@index([supplierApprovalStatus])
  @@index([supplierReviewedByAdminId])
  @@map("users")
}

model UserAddress {
  id            String   @id @default(cuid())
  userId        String
  label         String
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  landmark      String?
  city          String
  state         String
  postalCode    String
  country       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, isDefault])
  @@index([userId, createdAt])
  @@map("user_addresses")
}

model UserVehicle {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  make      String
  model     String
  vin       String?
  mileage   Int      @default(0)
  status    String   @default("Active")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, vin])
  @@index([userId, isPrimary])
  @@index([userId, createdAt])
  @@map("user_vehicles")
}

model FleetVehicle {
  id          String             @id @default(cuid())
  fleetId     String
  vehicleName String
  vin         String
  mileage     Int
  driver      String?
  status      FleetVehicleStatus @default(active)
  year        Int
  make        String
  model       String
  trim        String?
  isPrimary   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  fleet       User               @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  rfqs        Rfq[]

  @@unique([fleetId, vin])
  @@index([fleetId, status])
  @@index([vin])
  @@map("fleet_vehicles")
}

model Rfq {
  id                  String    @id @default(cuid())
  publicId            String    @unique @default(dbgenerated("next_rfq_public_id()"))
  requesterId         String?
  fleetVehicleId      String?
  source              RfqSource
  status              RfqStatus @default(open)
  projectName         String
  description         String?
  responseDeadline    DateTime
  deliveryRequirement String
  paymentTerms        String
  companyName         String
  contactName         String
  email               String
  phone               String
  vehicleVin          String?
  vehicleYear         Int?
  vehicleMake         String?
  vehicleModel        String?
  vehicleTrim         String?
  attachmentKey       String?
  attachmentUrl       String?
  attachmentName      String?
  attachmentMimeType  String?
  attachmentSize      Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requester    User?         @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  fleetVehicle FleetVehicle? @relation(fields: [fleetVehicleId], references: [id], onDelete: SetNull)
  parts        RfqPart[]
  bids         RfqBid[]
  order        Order?

  @@index([requesterId])
  @@index([fleetVehicleId])
  @@index([status, createdAt])
  @@index([source])
  @@map("rfqs")
}

model RfqBid {
  id           String       @id @default(cuid())
  rfqId        String
  supplierId   String
  totalAmount  Int
  deliveryDays Int
  partType     String       @default("New")
  validUntil   DateTime?
  notes        String?
  status       RfqBidStatus @default(submitted)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  rfq      Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier User   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  order    Order?

  @@unique([rfqId, supplierId])
  @@index([supplierId, status])
  @@index([rfqId, status])
  @@map("rfq_bids")
}

model Order {
  id                    String      @id @default(cuid())
  publicId              String      @unique @default(dbgenerated("next_order_public_id()"))
  source                OrderSource @default(rfq)
  rfqId                 String?     @unique
  bidId                 String?     @unique
  buyerId               String
  supplierId            String
  deliveryAddressId     String?
  deliveryRecipientName String?
  deliveryPhone         String?
  deliveryAddressLine1  String?
  deliveryAddressLine2  String?
  deliveryLandmark      String?
  deliveryCity          String?
  deliveryState         String?
  deliveryPostalCode    String?
  deliveryCountry       String?
  totalAmount           Int
  status                OrderStatus @default(pending)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  rfq             Rfq?         @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  bid             RfqBid?      @relation(fields: [bidId], references: [id], onDelete: Restrict)
  buyer           User         @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  supplier        User         @relation("OrderSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  deliveryAddress UserAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@index([buyerId, status])
  @@index([supplierId, status])
  @@index([deliveryAddressId])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  supplierPartId String?
  partName       String
  partNumber     String?
  quantity       Int
  unitPrice      Int?
  lineTotal      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierPart SupplierPart? @relation(fields: [supplierPartId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([supplierPartId])
  @@index([partNumber])
  @@map("order_items")
}

model RfqPart {
  id          String   @id @default(cuid())
  rfqId       String
  partName    String
  partNumber  String?
  quantity    Int
  targetPrice Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([partNumber])
  @@map("rfq_parts")
}

model GarageService {
  id              String              @id @default(cuid())
  publicId        String              @unique @default(dbgenerated("next_garage_service_public_id()"))
  garageId        String
  name            String
  category        String
  durationMinutes Int
  price           Int
  currency        String              @default("AED")
  bookingsCount   Int                 @default(0)
  status          GarageServiceStatus @default(active)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  garage   User                  @relation(fields: [garageId], references: [id], onDelete: Cascade)
  bookings GarageBooking[]
  reviews  GarageServiceReview[]

  @@index([garageId, status])
  @@index([garageId, createdAt])
  @@map("garage_services")
}

model GarageBooking {
  id              String              @id @default(cuid())
  publicId        String              @unique @default(dbgenerated("next_garage_booking_public_id()"))
  garageId        String
  customerId      String?
  serviceId       String?
  serviceName     String
  customerName    String
  customerEmail   String?
  customerPhone   String
  vehicleYear     String?
  vehicleMake     String?
  vehicleModel    String?
  vehicleVin      String?
  notes           String?
  bookingDate     DateTime            @db.Date
  bookingTime     String
  durationMinutes Int
  price           Int
  currency        String              @default("AED")
  status          GarageBookingStatus @default(confirmed)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  garage   User                 @relation("GarageBookingGarage", fields: [garageId], references: [id], onDelete: Cascade)
  customer User?                @relation("GarageBookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  service  GarageService?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  review   GarageServiceReview?

  @@index([garageId, bookingDate, bookingTime])
  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@map("garage_bookings")
}

model GarageServiceReview {
  id            String    @id @default(cuid())
  garageId      String
  serviceId     String
  customerId    String
  bookingId     String?   @unique
  rating        Int
  comment       String
  garageReply   String?
  garageReplyAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  garage   User           @relation("GarageServiceReviewGarage", fields: [garageId], references: [id], onDelete: Cascade)
  customer User           @relation("GarageServiceReviewCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  service  GarageService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  booking  GarageBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([garageId, createdAt])
  @@index([serviceId, rating])
  @@map("garage_service_reviews")
}

model GarageProfile {
  id                     String    @id @default(cuid())
  garageId               String    @unique
  contactEmail           String?
  contactEmailVerifiedAt DateTime?
  mobile                 String?
  mobileVerifiedAt       DateTime?
  workingDays            String[]  @default([])
  workingHours           String?
  workingHoursByDay      Json?
  garageImageUrl         String?
  garageImageKey         String?
  address                String?
  country                String?
  state                  String?
  city                   String?
  pincode                String?
  jobCompletedNumber     Int       @default(0)
  yearsExperience        Int       @default(0)
  responseTime           String?
  certifications         String[]  @default([])
  about                  String?
  galleryImageUrls       String[]  @default([])
  galleryImageKeys       String[]  @default([])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  garage User @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([contactEmail])
  @@index([mobile])
  @@map("garage_profiles")
}

model GarageVerificationRequest {
  id          String                   @id @default(cuid())
  garageId    String
  target      GarageVerificationTarget
  targetValue String
  tokenHash   String?
  otpHash     String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime                 @default(now())

  garage User @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId, target, consumedAt])
  @@index([expiresAt])
  @@map("garage_verification_requests")
}

model BusinessQuery {
  id        String              @id @default(cuid())
  publicId  String              @unique @default(dbgenerated("next_business_query_public_id()"))
  type      BusinessQueryType   @default(General)
  source    String
  name      String
  email     String
  phone     String?
  company   String
  message   String?
  pagePath  String?
  userAgent String?
  ipHash    String?
  status    BusinessQueryStatus @default(New)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([email])
  @@map("business_queries")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  accessJti        String
  deviceName       String?
  userAgent        String?
  ipHash           String?
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model admin {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String
  roleIds          String[]  @default([])
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions          adminSession[]
  reviewedSuppliers User[]         @relation("SupplierApprovalReviewer")
  notifications     Notification[] @relation("AdminNotificationRecipient")
  sentNotifications Notification[] @relation("AdminNotificationActor")
}

model Notification {
  id               String    @id @default(cuid())
  recipientUserId  String?
  recipientAdminId String?
  actorUserId      String?
  actorAdminId     String?
  type             String
  title            String
  body             String
  linkUrl          String?
  entityType       String?
  entityId         String?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recipientUser  User?  @relation("UserNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientAdmin admin? @relation("AdminNotificationRecipient", fields: [recipientAdminId], references: [id], onDelete: Cascade)
  actorUser      User?  @relation("UserNotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAdmin     admin? @relation("AdminNotificationActor", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientAdminId, readAt, createdAt])
  @@index([entityType, entityId])
  @@index([type, createdAt])
  @@map("notifications")
}

model role {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  permissionIds String[] @default([])
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
}

model adminSession {
  id               String    @id @default(cuid())
  adminId          String
  refreshTokenHash String    @unique
  accessJti        String
  deviceHash       String
  ipHash           String
  userAgent        String?
  familyTokenId    String
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedBy       String?
  lastUsedAt       DateTime  @default(now())
  rotationCount    Int       @default(0)
  createdAt        DateTime  @default(now())

  admin admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model MainWebsiteContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("main_website_contents")
}

model SupplierPart {
  id                     String                     @id @default(cuid())
  supplierId             String
  vendorSku              String?
  partUid                String?
  originalPartName       String
  originalBrand          String?
  originalMpn            String?
  originalOemNumber      String?
  normalizedMpn          String?
  normalizedOemNumber    String?
  price                  Int
  stock                  Int
  currency               String?
  category               String?
  oemSupersessionNumbers String[]                   @default([])
  competitorPartNumber   String?
  competitorBrandName    String?
  hsCode                 String?
  supplierImageUrls      String[]                   @default([])
  mappingStatus          SupplierPartMappingStatus  @default(uploaded)
  mappingSource          SupplierPartMappingSource?
  mappingError           String?
  rawUploadData          Json?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  supplier   User                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  part       PartMaster?          @relation(fields: [partUid], references: [partUid], onDelete: SetNull)
  orderItems OrderItem[]
  stockRows  SupplierPartStock[]
  pricing    SupplierPartPricing?

  @@unique([supplierId, vendorSku])
  @@index([supplierId])
  @@index([partUid])
  @@index([mappingStatus])
  @@index([normalizedMpn])
  @@index([normalizedOemNumber])
  @@map("supplier_parts")
}

model SupplierPartStock {
  id                String   @id @default(cuid())
  supplierId        String
  supplierPartId    String
  vendorSku         String
  warehouseId       String
  quantity          Int
  leadTime          String?
  lowStockThreshold Int?
  rawUploadData     Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier     User         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierPart SupplierPart @relation(fields: [supplierPartId], references: [id], onDelete: Cascade)

  @@unique([supplierId, vendorSku, warehouseId])
  @@index([supplierId])
  @@index([supplierPartId])
  @@index([vendorSku])
  @@map("supplier_part_stock")
}

model SupplierPartPricing {
  id                        String   @id @default(cuid())
  supplierId                String
  supplierPartId            String   @unique
  vendorSku                 String
  basePrice                 Int?
  discountPrice             Int?
  currency                  String   @default("AED")
  taxClass                  String?
  vat                       String?
  maxRetailPrice            Int?
  wholesaleDistributorPrice Int?
  fleetPrice                Int?
  rawUploadData             Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  supplier     User         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierPart SupplierPart @relation(fields: [supplierPartId], references: [id], onDelete: Cascade)

  @@unique([supplierId, vendorSku])
  @@index([supplierId])
  @@index([vendorSku])
  @@map("supplier_part_pricing")
}

model PartMaster {
  id                   String   @id @default(cuid())
  partUid              String   @unique
  source               String
  sourcePartId         String?
  partNumber           String?
  normalizedPartNumber String?
  partNumberOriginal   String?
  brandName            String?
  partName             String?
  category             String?
  groupId              String?
  groupName            String?
  imageUrl             String?
  imageUrls            String[] @default([])
  imageKeys            String[] @default([])
  badgeText            String?
  heading              String?
  description          String?
  keyFeatures          String[] @default([])
  raw17VinPartInfo     Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  supplierParts SupplierPart[]
  numbers       PartNumberIndex[]
  fitments      MasterFitment[]
  savedByUsers  UserSavedPart[]

  @@index([normalizedPartNumber])
  @@index([normalizedPartNumber, groupId])
  @@index([groupId])
  @@map("part_master")
}

model UserSavedPart {
  id        String   @id @default(cuid())
  userId    String
  partUid   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  part PartMaster @relation(fields: [partUid], references: [partUid], onDelete: Cascade)

  @@unique([userId, partUid])
  @@index([userId, createdAt])
  @@index([partUid])
  @@map("user_saved_parts")
}

model PartNumberIndex {
  id               String         @id @default(cuid())
  partUid          String
  numberOriginal   String
  numberNormalized String
  numberType       PartNumberType
  brand            String?
  source           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  part             PartMaster     @relation(fields: [partUid], references: [partUid], onDelete: Cascade)

  @@unique([partUid, numberNormalized, numberType])
  @@index([numberNormalized])
  @@index([numberNormalized, brand])
  @@index([partUid])
  @@map("part_number_index")
}

model MasterFitment {
  id              String   @id @default(cuid())
  partUid         String
  source          String
  vin17ModelId    String?
  brand           String?
  make            String?
  model           String?
  series          String?
  modelYear       Int?
  yearFrom        Int?
  yearTo          Int?
  engine          String?
  engineNo        String?
  cc              String?
  fuelType        String?
  transmission    String?
  bodyType        String?
  dateBegin       String?
  dateEnd         String?
  raw17VinVehicle Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  part PartMaster @relation(fields: [partUid], references: [partUid], onDelete: Cascade)

  @@unique([partUid, vin17ModelId])
  @@index([partUid])
  @@index([make, model, modelYear])
  @@index([brand, model, modelYear])
  @@index([engineNo])
  @@map("master_fitment")
}

model UnmatchedPartSearchLog {
  id               String   @id @default(cuid())
  searchedNumber   String
  normalizedNumber String
  userId           String?
  resultStatus     String
  createdAt        DateTime @default(now())

  @@index([normalizedNumber])
  @@index([userId])
  @@map("unmatched_part_search_logs")
}

model ApiRateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("api_rate_limits")
}
