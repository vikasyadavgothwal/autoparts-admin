generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Fleet
  User
  Garage
  Supplier
}

enum SupplierPartMappingStatus {
  uploaded
  processing
  mapped
  pending_review
  failed
}

enum SupplierPartMappingSource {
  local_db
  vin17 @map("17vin")
  manual
}

enum PartNumberType {
  mpn
  oem
  brand_part_number
  unknown
}

model User {
  id              String        @id @default(cuid())
  firebaseUid     String?       @unique
  email           String?       @unique
  phone           String?       @unique
  googleId        String?       @unique
  passwordHash    String?
  firstName       String?
  lastName        String?
  avatarUrl       String?
  companyName     String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  roles           UserRole[]    @default([User])
  activeRole      UserRole      @default(User)
  isActive        Boolean       @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  authVersion     Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        UserSession[]
  supplierParts   SupplierPart[]

  @@index([roles], type: Gin)
  @@index([activeRole])
  @@index([isActive])
  @@map("users")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  accessJti        String
  deviceName       String?
  userAgent        String?
  ipHash           String?
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model admin {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String
  roleIds          String[]  @default([])
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions adminSession[]
}

model role {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  permissionIds String[] @default([])
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
}

model adminSession {
  id               String    @id @default(cuid())
  adminId          String
  refreshTokenHash String    @unique
  accessJti        String
  deviceHash       String
  ipHash           String
  userAgent        String?
  familyTokenId    String
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedBy       String?
  lastUsedAt       DateTime  @default(now())
  rotationCount    Int       @default(0)
  createdAt        DateTime  @default(now())

  admin admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}


model MainWebsiteContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("main_website_contents")
}

model SupplierPart {
  id                  String                    @id @default(cuid())
  supplierId          String
  partUid             String?
  originalPartName    String
  originalBrand       String?
  originalMpn         String?
  originalOemNumber   String?
  normalizedMpn       String?
  normalizedOemNumber String?
  price               Int
  stock               Int
  currency            String?
  category            String?
  mappingStatus       SupplierPartMappingStatus @default(uploaded)
  mappingSource       SupplierPartMappingSource?
  mappingError        String?
  rawUploadData       Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  supplier User        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  part     PartMaster? @relation(fields: [partUid], references: [partUid], onDelete: SetNull)

  @@index([supplierId])
  @@index([partUid])
  @@index([mappingStatus])
  @@index([normalizedMpn])
  @@index([normalizedOemNumber])
  @@map("supplier_parts")
}

model PartMaster {
  id                    String   @id @default(cuid())
  partUid               String   @unique
  source                String
  sourcePartId          String?
  partNumber            String?
  normalizedPartNumber  String?
  partNumberOriginal    String?
  brandName             String?
  partName              String?
  category              String?
  groupId               String?
  groupName             String?
  imageUrl              String?
  imageUrls             String[] @default([])
  imageKeys             String[] @default([])
  badgeText             String?
  heading               String?
  description           String?
  keyFeatures           String[] @default([])
  raw17VinPartInfo      Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  supplierParts SupplierPart[]
  numbers       PartNumberIndex[]
  fitments      MasterFitment[]

  @@index([normalizedPartNumber])
  @@index([normalizedPartNumber, groupId])
  @@index([groupId])
  @@map("part_master")
}

model PartNumberIndex {
  id               String         @id @default(cuid())
  partUid          String
  numberOriginal   String
  numberNormalized String
  numberType       PartNumberType
  brand            String?
  source           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  part PartMaster @relation(fields: [partUid], references: [partUid], onDelete: Cascade)
  @@unique([partUid, numberNormalized, numberType])
  @@index([numberNormalized])
  @@index([numberNormalized, brand])
  @@index([partUid])
  @@map("part_number_index")
}

model MasterFitment {
  id              String   @id @default(cuid())
  partUid         String
  source          String
  vin17ModelId    String?
  brand           String?
  make            String?
  model           String?
  series          String?
  modelYear       Int?
  yearFrom        Int?
  yearTo          Int?
  engine          String?
  engineNo        String?
  cc              String?
  fuelType        String?
  transmission    String?
  bodyType        String?
  dateBegin       String?
  dateEnd         String?
  raw17VinVehicle Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  part PartMaster @relation(fields: [partUid], references: [partUid], onDelete: Cascade)

  @@unique([partUid, vin17ModelId])
  @@index([partUid])
  @@index([make, model, modelYear])
  @@index([brand, model, modelYear])
  @@index([engineNo])
  @@map("master_fitment")
}

model UnmatchedPartSearchLog {
  id               String   @id @default(cuid())
  searchedNumber   String
  normalizedNumber String
  userId           String?
  resultStatus     String
  createdAt        DateTime @default(now())

  @@index([normalizedNumber])
  @@index([userId])
  @@map("unmatched_part_search_logs")
}
